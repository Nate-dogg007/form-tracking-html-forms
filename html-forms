<script>
/*
  ░▒▓█ HTML Form Tracking → Google Ads Enhanced Conversions █▓▒░
  Author:  Nathan O'Connor
  Version: 1.4

  ─────────────────────────────────────────────────────────────
  WHAT THIS DOES
    • Captures form submissions a VISITOR made — native, AJAX-handled, and
      programmatic .submit(). Forms submitted by other tags on the page are
      ignored; see isVisitorForm() for why that needs saying.
    • Extracts ONLY Google's user-provided-data fields. Everything else —
      message boxes, free text, unrecognised inputs — is discarded.
    • Normalises to Google's spec, SHA-256 hashes the fields Google wants
      hashed, and leaves city/region/postal_code/country in the clear.
    • Pushes ONE `html_form_submit` event to the dataLayer, and holds the
      submission until the tag has fired. Every event carries
      `user_data_status` saying whether user data went with it and, if not,
      which of the reasons it was.

  WHERE IT SENDS
    Google Ads enhanced conversions (User-Provided Data) only.
    Do NOT wire the user_data object into GA4 — sending personal data to
    Analytics is against Google's terms, hashed or not.

  ─────────────────────────────────────────────────────────────
  HOW TO INSTALL

    ONE GTM Custom HTML tag. Paste this whole file in, set the three
    constants in CONFIG below — DEFAULT_COUNTRY, CONSENT_MODE and
    ASSUME_DEFAULT_COUNTRY — trigger it on All Pages, save.

    CONSENT_MODE decides whether anything is collected at all when the page
    emits no consent signal. ASSUME_DEFAULT_COUNTRY is the one most sites
    need and nobody expects: Google throws an address away unless it has
    first name, last name, postcode AND country, and almost no lead form
    asks for country. Leave it false and most forms send no address.
    That is it. There is no second tag.

  CONSENT

    Consent is checked here, on every submission, before a single field
    is read. Granted -> `html_form_submit` carries `user_data`. Denied ->
    `html_form_submit` fires with the form id and name only, and nothing
    personal is read, hashed or pushed.

    No readable signal at all is the case that needs a decision, because
    "this site has no CMP" and "this site has a CMP that never emits" look
    the same from here. CONSENT_MODE is where you state which it is.

    That covers withdrawal mid-session too, which a GTM tag-level check
    cannot: the listener lives for the whole page, so consent has to be
    re-read at the moment it matters.

    Google Ads already refuses to transmit user-provided data when
    ad_user_data is denied. This gate is not about that. It is about
    keeping hashed personal data out of window.dataLayer, which every
    other tag in the container and every third-party script on the page
    can read regardless of what Google Ads decides.

    The conversion is never the thing being gated. `html_form_submit`
    fires on every visitor submission in every case above — only the
    `user_data` payload is withheld. Anything that suppresses the event
    itself is a bug, not a stricter reading of consent.

  WHAT user_data_status MEANS

    collected             user_data attached, after a positive signal
    collected_undeclared  user_data attached because CONSENT_MODE = 'none'
    consent_denied        a signal said no
    no_consent_signal     CONSENT_MODE = 'cmp' and nothing emitted a signal
    region_unresolved     consent is set per region, which a browser cannot
                          resolve; only affects visitors who never answered
    no_fields             consent fine, nothing on the form to match on
    no_crypto             SubtleCrypto missing, so not a secure context
    error                 hashing or assembly threw

    `cmp_detected` is added whenever no consent signal could be read and a
    known CMP was nonetheless found on the page — so it can accompany any
    status that follows from that state, not only the two no-signal ones
    (a form with no matchable fields still reports no_fields, and still
    says which CMP was sitting there silent).

    With no_consent_signal it names what to go and wire up; with
    collected_undeclared it means the site declared 'none' and was wrong.
    Either way, treat it as a bug report about the install.

*/

(function () {
  'use strict';

  /* ══ CONFIG ══════════════════════════════════════════════════════════ */

  // ISO 3166-1 alpha-2 for your primary audience. Used to turn national
  // phone formats (07700 900123) into E.164 (+447700900123). Get this wrong
  // and every hashed phone silently fails to match.
  var DEFAULT_COUNTRY = 'GB';

  // Skip any form containing a password field (login / registration).
  var SKIP_PASSWORD_FORMS = true;

  // Google will not use an address unless it has first name, last name,
  // postcode AND country. Most lead forms collect the first three and never
  // ask for country, so the address is discarded for want of one value that
  // is the same for every visitor the site has.
  //
  // Turn this on to fill country from DEFAULT_COUNTRY when it is the only
  // field missing. It is an assumption, so it is off by default — but the
  // cost of a wrong one is only that the address fails to match, which is
  // where it already was. Leave it off if the site takes enquiries from
  // everywhere and you would rather send nothing than guess.
  var ASSUME_DEFAULT_COUNTRY = false;

  // Does this site have a consent management platform?
  //
  //   'cmp'  — yes. An ad_user_data signal is required. No signal means the
  //            CMP is not wired to Consent Mode v2, so nothing is collected.
  //   'none' — no. Nothing on the page gates collection and you have a
  //            lawful basis, so collect when no signal is present.
  //
  // A signal always wins where there is one: 'none' still honours a denial
  // if a CMP turns up and says no.
  //
  // This has to be declared because it cannot be worked out. "No CMP here"
  // and "a CMP that never emits Consent Mode" are the same absence of a
  // signal, and JavaScript cannot tell them apart. Declaring which one you
  // are in is what lets the script complain about the second — see
  // CMP_SIGNATURES. Get it wrong in the 'none' direction on a site that
  // does have a banner and you collect from people who declined.
  var CONSENT_MODE = 'cmp';

  // Report forms the site cancels and posts over XHR itself — the normal
  // shape of a WordPress form plugin. Leave this on: with it off, a site
  // whose forms are all AJAX reports nothing at all, which is what v1.2 did.
  //
  // The trade-off, stated plainly: this fires when the submission is
  // ATTEMPTED. A script that cancels the submit because its own validation
  // failed looks identical from here to one that cancels in order to post,
  // so a form validated in JavaScript rather than by the browser can report a
  // submission that never went anywhere. Native HTML5 validation is not
  // affected — it stops the submit event before anything here runs.
  //
  // Turn this off only if you know the site validates in JS and you would
  // rather under-count than over-count.
  var REPORT_AJAX_SUBMISSIONS = true;

  // Hard cap on how long a submission is held while hashing + tag firing
  // complete. The form always submits, timeout or not.
  var MAX_DELAY_MS = 1200;

  // Log to console. Leave false in production.
  var DEBUG = false;

  // The dataLayer event name. Deliberately NOT `form_submit`: GA4's
  // enhanced measurement collects an automatic event by that exact name,
  // so sharing it makes reports and tag configuration ambiguous for no
  // benefit. Change it here if you prefer a different namespace, and use
  // the same value in your GTM trigger.
  var EVENT_NAME = 'html_form_submit';

  /* ════════════════════════════════════════════════════════════════════ */


  // Dial codes for DEFAULT_COUNTRY. Numbers already in international format
  // (+44…, 0044…) are used as-is regardless of what is listed here.
  var DIAL_CODES = {
    GB: '44',  US: '1',   CA: '1',   IE: '353', AU: '61',  NZ: '64',
    ZA: '27',  IN: '91',  DE: '49',  FR: '33',  ES: '34',  IT: '39',
    NL: '31',  BE: '32',  LU: '352', CH: '41',  AT: '43',  PT: '351',
    SE: '46',  NO: '47',  DK: '45',  FI: '358', IS: '354', PL: '48',
    CZ: '420', SK: '421', HU: '36',  RO: '40',  BG: '359', GR: '30',
    HR: '385', SI: '386', EE: '372', LV: '371', LT: '370', CY: '357',
    MT: '356', JP: '81',  CN: '86',  HK: '852', SG: '65',  MY: '60',
    TH: '66',  PH: '63',  ID: '62',  KR: '82',  AE: '971', SA: '966',
    IL: '972', TR: '90',  BR: '55',  MX: '52',  AR: '54',  CL: '56',
    CO: '57',  NG: '234', KE: '254', EG: '20'
  };

  // Country dropdowns usually hold names, not codes. Google wants alpha-2.
  // Extend this if your audience sits outside the list.
  var COUNTRY_ALIASES = {
    'united kingdom': 'GB', 'great britain': 'GB', 'uk': 'GB',
    'england': 'GB', 'scotland': 'GB', 'wales': 'GB',
    'northern ireland': 'GB',
    'united states': 'US', 'united states of america': 'US',
    'usa': 'US', 'america': 'US',
    'ireland': 'IE', 'republic of ireland': 'IE',
    'australia': 'AU', 'new zealand': 'NZ', 'canada': 'CA',
    'south africa': 'ZA', 'germany': 'DE', 'france': 'FR',
    'spain': 'ES', 'italy': 'IT', 'netherlands': 'NL',
    'belgium': 'BE', 'portugal': 'PT', 'poland': 'PL',
    'sweden': 'SE', 'norway': 'NO', 'denmark': 'DK',
    'finland': 'FI', 'switzerland': 'CH', 'austria': 'AT',
    'india': 'IN', 'japan': 'JP', 'china': 'CN',
    'singapore': 'SG', 'united arab emirates': 'AE', 'uae': 'AE',
    'brazil': 'BR', 'mexico': 'MX'
  };

  // Allowlist. A field is collected only if its normalised name matches
  // one of these exactly (after prefix stripping), or it carries an
  // explicit data-upd attribute. Nothing else leaves the page.
  var SYNONYMS = {
    email: [
      'email', 'emailaddress', 'email_address', 'e_mail', 'mail'
    ],
    phone_number: [
      'phone', 'phonenumber', 'phone_number', 'phone_no', 'tel',
      'telephone', 'telephone_number', 'mobile', 'mobile_number',
      'mobile_phone', 'cell', 'cellphone', 'cell_phone',
      'mobilephone', 'homephone', 'workphone'      // HubSpot property names
    ],
    first_name: [
      'first_name', 'firstname', 'fname', 'first', 'given_name',
      'givenname', 'forename'
    ],
    last_name: [
      'last_name', 'lastname', 'lname', 'last', 'surname',
      'family_name', 'familyname'
    ],
    street: [
      'street', 'street_address', 'streetaddress', 'address',
      'address_1', 'address1', 'address_line_1', 'addressline1',
      'addr', 'addr1'
    ],
    postal_code: [
      'postcode', 'post_code', 'postalcode', 'postal_code',
      'zip', 'zipcode', 'zip_code'
    ],
    country: [
      'country', 'country_code', 'countrycode'
    ]
  };

  // A single field holding a whole name. Split into first + last.
  var FULL_NAME = ['name', 'full_name', 'fullname', 'complete_name'];

  /*
    Accepted only through an explicit data-upd attribute, never matched by
    field name. city and region reach Google unhashed, and no name-based
    heuristic can separate "Hampshire" from "cancer" — a shape check that
    rejects a long sentence still lets "HIV positive" through, and a field
    called `state` is not always a US state. Google needs these only
    alongside a full address, which already requires first name, last
    name, postcode and country, so the match-rate cost is close to nil.
  */
  var EXPLICIT_ONLY = ['city', 'region'];

  /*
    Never matched, however they normalise. Several WordPress form plugins
    ship a `form_name` field carrying the form's own title, which would
    otherwise be split and hashed as the visitor's name — worse than
    over-collecting, because it poisons the match data with something that
    is not a person. A username is not a full name either.
  */
  var NEVER_MATCH = [
    'form_name', 'field_name', 'user_name', 'username',
    'form_id', 'field_id', 'form_title'
  ];

  // Stripped from the front of a field name before matching, so
  // `your-email` and `billing_email` both resolve to `email`.
  var PREFIXES = [
    'your', 'user', 'contact', 'billing', 'shipping', 'delivery',
    'customer', 'client', 'primary', 'main', 'input', 'field',
    'form', 'entry', 'the', 'address', 'fields'
  ];

  // Countries where the national trunk zero is part of the E.164 number
  // rather than something to strip. Italian landlines keep it: 06 1234 5678
  // is +39 06 1234 5678, not +39 612345678. Check your market before
  // trusting this list; it is short because most countries drop the zero.
  var KEEP_TRUNK_ZERO = ['IT'];

  var HASHED_KEYS = ['email', 'phone_number', 'first_name', 'last_name', 'street'];
  var PLAIN_KEYS  = ['city', 'region', 'postal_code', 'country'];

  // city and region are passed through unhashed, so they are the one route
  // by which free text could reach the dataLayer. A field named `state` is
  // not always a US state ("please state your requirements"), so validate
  // shape rather than trusting the field name.
  var MAX_PLAIN_LENGTH = 60;

  function log() {
    if (!DEBUG || !window.console) return;
    try { console.log.apply(console, ['[form-tracking]'].concat([].slice.call(arguments))); } catch (e) {}
  }

  /* ── Install guard ───────────────────────────────────────────────────
     A tag that fires twice must not double-count.                      */

  // Shape-checked, because `window.__formTracking` is clobberable by any
  // element carrying id="__formTracking". Without this, an HTML injection
  // sink with no script at all silently kills conversion tracking.
  var STATE = window.__formTracking;
  if (!STATE || typeof STATE !== 'object' || !(STATE.handlers instanceof Array)) {
    STATE = window.__formTracking = {
      installed: false, hooked: false, handlers: [],
      resubmitting: false, inFlight: [], reported: []
    };
  }

  if (!(STATE.inFlight instanceof Array)) STATE.inFlight = [];
  // Deliberately NOT inFlight. That list means "this form is being held and
  // will be resubmitted", and the programmatic .submit() hook reads it as a
  // reason to swallow a call. A form reported on the AJAX path is not held by
  // anything, so reusing the list there would silently block a later
  // .submit() the site actually meant.
  if (!(STATE.reported instanceof Array)) STATE.reported = [];

  if (STATE.installed) {
    log('already installed, skipping');
    return;
  }
  STATE.installed = true;

  // SubtleCrypto needs a secure context. Without it nothing can be hashed,
  // and sending personal data unhashed is not an option — so the tag still
  // reports submissions, just never with user_data attached.
  var CAN_HASH = !!(window.crypto && window.crypto.subtle);
  if (!CAN_HASH) log('SubtleCrypto unavailable (needs HTTPS) — user data disabled');

  /* ── Runtime consent ────────────────────────────────────────────────
     GTM checks consent once, when it decides whether to run this tag.
     That is not enough on its own. The listener installed here lives for
     the whole page, so a visitor who withdraws consent mid-session would
     otherwise keep having their data read, hashed and disclosed into a
     global array that every other tag on the page can read. So consent is
     re-checked on every submission, not just at install.

     Read from the dataLayer rather than google_tag_data.ics, which is
     internal and undocumented. Consent Mode writes every default and
     update call into the dataLayer, so the last one to mention
     ad_user_data is the current state. Override with
     window.formTrackingConsentFn if your CMP does something unusual.    */

  /*
    Known CMPs, by the cheapest reliable fingerprint each one leaves on the
    page. This list exists for exactly one purpose: to contradict
    CONSENT_MODE = 'none'. It never decides whether to collect.

    That distinction is the whole point. A fingerprint list is always
    incomplete — a custom banner or a CMP added next year will not be on it
    — which makes it unfit to grant or deny anything. It is perfectly fit
    to catch someone declaring 'none' on a site that visibly has a banner,
    because a hit is conclusive even though a miss is not.
  */
  var CMP_SIGNATURES = [
    ['CookieYes', function () {
      return !!window.getCkyConsent ||
             !!document.querySelector('script[src*="cookieyes"]');
    }],
    ['OneTrust', function () {
      return !!window.OneTrust || !!window.Optanon;
    }],
    ['Cookiebot', function () {
      return !!window.Cookiebot || !!document.getElementById('Cookiebot');
    }],
    ['HubSpot', function () {
      return !!document.querySelector(
        'script[src*="hs-banner.com"], script[id^="cookieBanner-"]');
    }],
    ['Complianz', function () {
      return !!window.cmplz_get_cookie ||
             !!document.querySelector('script[src*="complianz"]');
    }],
    ['Termly', function () {
      return !!document.querySelector('script[src*="termly"]');
    }],
    ['Iubenda', function () {
      return !!window._iub;
    }],
    ['Usercentrics', function () {
      return !!window.UC_UI || !!window.usercentrics;
    }],
    ['Osano', function () {
      return !!window.Osano;
    }],
    ['IAB TCF', function () {
      return typeof window.__tcfapi === 'function';
    }]
  ];

  function detectCmp() {
    for (var i = 0; i < CMP_SIGNATURES.length; i++) {
      try {
        if (CMP_SIGNATURES[i][1]()) return CMP_SIGNATURES[i][0];
      } catch (err) {
        // A CMP that throws when probed is not worth failing a submission
        // over. Treat it as absent and keep checking the rest.
      }
    }
    return null;
  }

  var warnedNoConsentSignal = false;
  var warnedCmpContradiction = false;
  var warnedBadConsentMode = false;
  var warnedRegionUnresolved = false;

  /*
    Anything that is not exactly 'none' falls through to the fail-closed
    branch, which is the safe direction but a baffling one to debug: someone
    who typed 'None' gets told to set CONSENT_MODE = "none", which is what
    they believe they did. Say so plainly instead.
  */
  function consentModeIsNone() {
    if (CONSENT_MODE === 'none') return true;
    if (CONSENT_MODE !== 'cmp') {
      warnedBadConsentMode = warnOnce(warnedBadConsentMode,
        'CONSENT_MODE is ' + JSON.stringify(CONSENT_MODE) + ', which is neither ' +
        '"cmp" nor "none". Treating it as "cmp", so no user data will be ' +
        'collected without a consent signal. Check for a typo or stray whitespace.');
    }
    return false;
  }

  // Deliberately not behind DEBUG. Silence in either of these cases looks
  // identical to "enhanced conversions is working", which is the failure
  // this whole script exists to stop.
  function warnOnce(already, message) {
    if (already || !window.console || !console.warn) return true;
    try { console.warn('[form-tracking] ' + message); } catch (err) {}
    return true;
  }

  /*
    Reads the current consent position without judging it: 'granted',
    'denied', or 'no_signal' when nothing readable said either way.

    Every unreadable outcome — a malformed shape, a dataLayer that has been
    reset, a region-scoped entry we cannot place — reports 'no_signal'
    rather than guessing. What that means is CONSENT_MODE's decision, made
    in consentDecision() below, and it is the only place the two are
    allowed to be conflated.
  */
  function consentState() {
    if (typeof window.formTrackingConsentFn === 'function') {
      try {
        // Strict equality on purpose: the natural way to write a CMP
        // adapter returns undefined on its deny branch. Note that defining
        // the function is itself a declaration, so there is no 'no_signal'
        // outcome on this path — an adapter that cannot tell should throw.
        return window.formTrackingConsentFn() === true ? 'granted' : 'denied';
      } catch (err) {
        log('consent function threw, treating as denied', err);
        return 'denied';
      }
    }

    var dl = window.dataLayer;
    var state = null;
    var sawUpdate = false;
    var sawRegionScoped = false;

    if (dl && typeof dl.length === 'number') {
      for (var i = 0; i < dl.length; i++) {
        var entry = dl[i];
        if (!entry || entry[0] !== 'consent') continue;
        var command = entry[1];
        if (command !== 'default' && command !== 'update') continue;
        var settings = entry[2];
        if (!settings || typeof settings !== 'object') continue;
        // Checked before the region test, so a region-scoped entry about
        // some other consent type does not make this one unresolvable.
        if (typeof settings.ad_user_data !== 'string') continue;
        /*
          Region scoping is a feature of the `default` command only —
          Google documents it as "specify a region (according to ISO
          3166-2) in your gtag consent default command", and the gtag
          reference does not list region among the consent parameters at
          all. So a region key on an `update` is not a scoping
          instruction, and treating it as one threw away the visitor's
          own answer: a CMP that builds one settings object and reuses it
          across both commands had its update ignored, and a stale
          earlier denial stood instead.

          Region-scoped defaults are noted, not read — see below.
        */
        // Length-checked, not just truthy: some CMPs emit `region: []`
        // rather than omitting the key, and an empty array is truthy in
        // JavaScript — which turned a perfectly readable global default
        // into region_unresolved and collected nothing.
        if (command === 'default' && settings.region && settings.region.length) {
          sawRegionScoped = true;
          continue;
        }
        /*
          Once the visitor has answered, a later `default` is ignored.

          This is our choice, not a documented Consent Mode guarantee —
          Google's docs are silent on the interaction, and a stray
          `default` re-firing after a CMP's `update` is a known way to
          reset consent state in a real container. We privilege the
          answer because the alternative lets a leftover hardcoded
          default overrule what the visitor actually clicked.

          The residual risk runs one way: update-granted followed by
          default-denied keeps us collecting while Google's own state may
          have reverted. A stray default is a container bug either way,
          and this is the direction that respects the click.
        */
        if (command === 'default' && sawUpdate) continue;
        state = settings.ad_user_data === 'granted';
        if (command === 'update') sawUpdate = true;
      }
    }

    /*
      A visitor who answers the banner gets an update pushed globally, not
      per region, so their own choice resolves the question no matter what
      the regional defaults said. Take it and stop.
    */
    if (sawUpdate) return state ? 'granted' : 'denied';

    /*
      No update, and at least one region-scoped default mentioned
      ad_user_data. This is unresolvable, and it took a live leak to see it.

      The standard Consent Mode v2 configuration is a restrictive default
      for a list of regions plus a permissive global fallback for everyone
      else. Which of those applies depends on where the visitor is, and this
      code runs in a browser that is not told. The previous version skipped
      region-scoped entries as "probably somewhere else" and read the
      fallback instead — so a visitor inside a denied region who never
      touched the banner had their hashed email pushed to the dataLayer,
      reported as a clean success.

      Guessing has no safe direction here: read the fallback and you
      over-collect, ignore it and you under-collect. So report neither.
      CONSENT_MODE decides what silence means, as it does everywhere else,
      and window.formTrackingConsentFn is the way out for a site that really
      does use regional defaults — its CMP knows the region and we do not.
    */
    if (sawRegionScoped) return 'region_unresolved';

    if (state === null) return 'no_signal';
    return state ? 'granted' : 'denied';
  }

  /*
    Turns that reading into a decision, given what the site declared.

      granted   -> collect, whatever CONSENT_MODE says
      denied    -> do not, whatever CONSENT_MODE says
      no_signal -> CONSENT_MODE decides

    A present signal winning in both directions is what makes 'none' safe
    to set on a site that later acquires a CMP: the declaration only ever
    governs the silence.

    Returns { collect, status, cmp }. `cmp` is set only where there was no
    signal to read, and it rides on the payload so the state is visible in
    GTM rather than only in a console nobody has open. A named CMP next to
    a missing signal is the difference between "something is wrong" and
    "go and wire this specific thing up".
  */
  function consentDecision() {
    var state = consentState();

    if (state === 'granted') return { collect: true,  status: 'collected',      cmp: null };
    if (state === 'denied')  return { collect: false, status: 'consent_denied', cmp: null };

    // No readable signal. Whichever way CONSENT_MODE resolves that, whether
    // a CMP is sitting on the page is the fact that tells you what to fix,
    // so look either way — it just means different things in each.
    var cmp = detectCmp();

    if (consentModeIsNone()) {
      // Region-scoped consent entries are themselves proof that something is
      // managing consent here, whether or not it left a fingerprint we know.
      var evidence = cmp ||
        (state === 'region_unresolved' ? 'region-scoped Consent Mode entries are' : null);
      if (evidence) {
        warnedCmpContradiction = warnOnce(warnedCmpContradiction,
          'CONSENT_MODE is "none" but ' + evidence + ' on this page. User data ' +
          'is being collected without checking it. Either wire consent up to ' +
          'Consent Mode v2, point window.formTrackingConsentFn at it, or set ' +
          'CONSENT_MODE = "cmp".');
      }
      return { collect: true, status: 'collected_undeclared', cmp: cmp };
    }

    if (state === 'region_unresolved') {
      warnedRegionUnresolved = warnOnce(warnedRegionUnresolved,
        'consent here is configured per region, and a browser is not told ' +
        'which region the visitor is in — so which default applies to them ' +
        'cannot be worked out and no user data was collected. Visitors who ' +
        'answer the banner are unaffected, because their choice is pushed ' +
        'globally. To collect from the rest, point ' +
        'window.formTrackingConsentFn at your CMP\'s own resolved state.');
      return { collect: false, status: 'region_unresolved', cmp: cmp };
    }

    warnedNoConsentSignal = warnOnce(warnedNoConsentSignal, cmp
      ? cmp + ' is on this page but is not emitting an ad_user_data signal, ' +
        'so user-provided data was not collected. Wire ' + cmp + ' to Consent ' +
        'Mode v2, or point window.formTrackingConsentFn at it.'
      : 'no ad_user_data consent signal found in the dataLayer, so ' +
        'user-provided data was not collected. Configure Consent Mode v2, set ' +
        'window.formTrackingConsentFn, or set CONSENT_MODE = "none" if this ' +
        'site has no CMP and you have another lawful basis.');
    return { collect: false, status: 'no_consent_signal', cmp: cmp };
  }

  /* ── Normalisation ──────────────────────────────────────────────────
     Google's documented rules: trim, lowercase, E.164 phone numbers, and
     strip dots before the domain on gmail.com / googlemail.com.        */

  function normKey(str) {
    return String(str).trim().toLowerCase()
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/_+/g, '_')
      .replace(/^_|_$/g, '');
  }

  function lookup(key) {
    if (FULL_NAME.indexOf(key) !== -1) return 'full_name';
    for (var canonical in SYNONYMS) {
      if (SYNONYMS.hasOwnProperty(canonical) &&
          SYNONYMS[canonical].indexOf(key) !== -1) return canonical;
    }
    return null;
  }

  /*
    Try the allowlist at every prefix-strip level, most specific first.
    Matching only the fully stripped key meant `form_fields[email]`
    (Elementor) stalled on `fields_email` and `address[zip]` (Shopify)
    never stripped at all, so those forms produced nothing. Going level by
    level also keeps `address_1` resolving to street, because it matches
    before `address` is treated as a prefix.
  */
  function matchKey(key) {
    // Checked against the raw key, before any stripping: `form_name`
    // would otherwise strip to `name` and be read as the visitor's.
    if (NEVER_MATCH.indexOf(key) !== -1) return null;
    var parts = key.split('_');
    var guard = 0;
    while (guard <= 4) {
      var candidate = parts.join('_');
      if (!candidate) return null;
      var hit = lookup(candidate);
      if (hit) return hit;
      if (parts.length < 2 || PREFIXES.indexOf(parts[0]) === -1) return null;
      parts.shift();
      guard++;
    }
    return null;
  }

  function normText(v) {
    return String(v).trim().toLowerCase().replace(/\s+/g, ' ');
  }

  function normEmail(v) {
    var s = String(v).trim().toLowerCase().replace(/\s+/g, '');
    var at = s.lastIndexOf('@');
    if (at < 1 || s.indexOf('.', at) === -1 || at === s.length - 1) return '';
    var local = s.slice(0, at);
    var domain = s.slice(at + 1);
    if (domain === 'gmail.com' || domain === 'googlemail.com') {
      // Google's rule for these two domains: drop the plus suffix, then the
      // periods. Jane.Doe+Shopping@googlemail.com -> janedoe@googlemail.com.
      // Skipping the plus step produces a hash Google will never hold, and
      // plus-addressing is common among the people filling in marketing forms.
      local = local.split('+')[0].replace(/\./g, '');
    }
    return local ? local + '@' + domain : '';
  }

  function normPhone(v) {
    var s = String(v).trim();
    // "(0)" is the explicit "drop this when dialling internationally"
    // notation, as in +44 (0)7700 900123.
    s = s.replace(/\(\s*0\s*\)/g, '');
    var international = s.charAt(0) === '+';
    var d = s.replace(/\D/g, '');
    if (!d) return '';

    if (!international) {
      if (d.slice(0, 2) === '00') {
        d = d.slice(2);
      } else {
        var country = String(DEFAULT_COUNTRY).toUpperCase();
        var cc = DIAL_CODES[country];
        if (!cc) return '';                       // unknown country, don't guess
        if (d.charAt(0) === '0' && KEEP_TRUNK_ZERO.indexOf(country) === -1) {
          d = cc + d.replace(/^0+/, '');          // national trunk prefix
        } else if (d.slice(0, cc.length) !== cc) {
          d = cc + d;
        }
      }
    } else if (d.charAt(0) === '0') {
      return '';                                  // +0... is not a country code
    }

    // E.164 is 1–3 digits of country code plus up to 15 total.
    if (d.length < 7 || d.length > 15) return '';
    return '+' + d;
  }

  function normPostal(v) {
    // Collapse internal whitespace rather than stripping it. Google
    // normalises postal codes itself and its own worked example keeps the
    // space (SO99 9XX), so there is nothing to gain from a lossier
    // transform on the one address key UK matching leans on.
    var s = String(v).trim().toLowerCase().replace(/\s+/g, ' ');
    if (!s || s.length > 12 || s.indexOf('@') !== -1) return '';
    return s;
  }

  // For city and region, which are sent unhashed. Reject anything shaped
  // like prose or an identifier rather than a place name.
  function normPlace(v) {
    var s = normText(v);
    if (!s || s.length > MAX_PLAIN_LENGTH) return '';
    if (s.indexOf('@') !== -1) return '';
    if (s.split(' ').length > 4) return '';
    if (/\d{4,}/.test(s)) return '';
    return s;
  }

  function normCountry(v) {
    var s = String(v).trim();
    if (/^[A-Za-z]{2}$/.test(s)) return s.toUpperCase();
    var alias = COUNTRY_ALIASES[normText(s)];
    return alias || '';                           // drop rather than mismatch
  }

  function splitFullName(v) {
    var parts = normText(v).split(' ');
    var clean = [];
    for (var i = 0; i < parts.length; i++) { if (parts[i]) clean.push(parts[i]); }
    if (clean.length < 2) return null;            // one word tells us nothing
    return { first_name: clean[0], last_name: clean[clean.length - 1] };
  }

  function normalise(key, value) {
    switch (key) {
      case 'email':        return normEmail(value);
      case 'phone_number': return normPhone(value);
      case 'postal_code':  return normPostal(value);
      case 'country':      return normCountry(value);
      case 'city':
      case 'region':       return normPlace(value);
      default:             return normText(value);
    }
  }

  /* ── Hashing ────────────────────────────────────────────────────────
     Hex-encoded SHA-256, lowercase, as Google requires.                */

  function sha256Hex(str) {
    if (!str) return Promise.resolve('');
    var data = new TextEncoder().encode(str);
    return window.crypto.subtle.digest('SHA-256', data).then(function (buf) {
      var bytes = new Uint8Array(buf);
      var out = '';
      for (var i = 0; i < bytes.length; i++) {
        out += ('0' + bytes[i].toString(16)).slice(-2);
      }
      return out;
    })['catch'](function (err) {
      log('hash failed', err);
      return '';
    });
  }

  /* ── Field matching ─────────────────────────────────────────────────
     Explicit data-upd wins. Otherwise exact match against the allowlist
     after prefix stripping. No substring matching — that is how v1.1
     ended up hashing `company_name`.                                   */

  function canonicalKey(field) {
    var explicit = field.getAttribute && field.getAttribute('data-upd');
    if (explicit) {
      var e = normKey(explicit);
      if (e === 'ignore') return null;
      if (e === 'full_name' || FULL_NAME.indexOf(e) !== -1) return 'full_name';
      if (SYNONYMS.hasOwnProperty(e) || EXPLICIT_ONLY.indexOf(e) !== -1) return e;
      log('unknown data-upd value:', explicit);
      return null;
    }

    var name = field.getAttribute && field.getAttribute('name');
    if (!name) return null;

    var key = normKey(name);
    if (!key) return null;

    return matchKey(key);
  }

  /* ── Form reading ───────────────────────────────────────────────────
     form.elements and form.id are both clobberable by an input named
     `elements` or `id`, so read them off the prototype / attributes.   */

  var elementsGetter = (function () {
    try {
      var d = Object.getOwnPropertyDescriptor(HTMLFormElement.prototype, 'elements');
      return (d && d.get) || null;
    } catch (e) { return null; }
  })();

  function formElements(form) {
    if (elementsGetter) {
      try { return elementsGetter.call(form); } catch (e) {}
    }
    return form.querySelectorAll('input, select, textarea');
  }

  /*
    Deliberately no page path. Nothing here needs one, and GTM can read
    the URL itself if a tag ever wants it. Copying it into the dataLayer
    would mean that on a site putting identifiers in the URL
    (/account/<email>/reset, /booking/AB12CD) every form submission
    disclosed one, including when consent has been denied.

    form_id and form_name are page-controlled strings. A templated form
    title interpolating a customer name would land here, so keep form
    titles static.
  */
  function formDetails(form) {
    return {
      form_id:   form.getAttribute('id') || '',
      form_name: form.getAttribute('data-title') ||
                 form.getAttribute('name') ||
                 form.getAttribute('id') || 'unnamed_form'
    };
  }

  var COLLECTABLE_TAGS = ['INPUT', 'SELECT', 'TEXTAREA'];

  function skipField(field) {
    var type = (field.type || '').toLowerCase();
    // <output> and <fieldset> are form-associated and appear in
    // form.elements, but <output> has no `type` and so slips past every
    // check below while still exposing a string .value.
    if (COLLECTABLE_TAGS.indexOf(field.tagName) === -1) return true;
    if (field.disabled) return true;
    // Hidden fields are populated by the site, not the visitor. CRM forms
    // routinely carry a hidden owner or assigned-rep email, which would
    // otherwise be hashed and reported as the person who submitted. Use
    // data-upd to opt a hidden field in deliberately.
    if (type === 'hidden' && !(field.getAttribute && field.getAttribute('data-upd'))) {
      return true;
    }
    if (type === 'password') return true;                    // never, under any name
    if (type === 'submit' || type === 'button' || type === 'reset' ||
        type === 'image'  || type === 'file') return true;
    if ((type === 'checkbox' || type === 'radio') && !field.checked) return true;
    var ac = (field.getAttribute && field.getAttribute('autocomplete') || '').toLowerCase();
    if (ac.indexOf('cc-') === 0 || ac === 'new-password' ||
        ac === 'current-password') return true;              // payment / credentials
    if (field.hasAttribute && field.hasAttribute('data-no-track')) return true;
    return false;
  }

  /*
    Did a visitor submit this, or did a tag?

    Third-party tags submit hidden forms as a transport. The Meta Pixel builds

      <form action="https://www.facebook.com/tr/" target="fb0542…">
        <iframe src="about:blank" name="fb0542…"></iframe>
      </form>

    appends it to the page and calls .submit() on it. Because the hook below
    patches HTMLFormElement.prototype globally, every one of those arrived here
    as a conversion. Measured on a live site: clicking "Next" in a five-step
    quote form reported a lead on each step, because the pixel fired on the
    interaction — the form itself was never submitted at all. Google's own
    gtag does the same thing.

    The test is structural, not a list of pixel hostnames. A denylist is only
    ever the set of tags someone knew about on the day it was written, and the
    failure it allows is silent: a conversion count that looks healthy.

    What separates the two is that a visitor can only fill in a form that was
    put in front of them. A transport form is never rendered.

    The obvious test — "does it carry any non-hidden controls" — is not enough,
    and measuring beat guessing here. The pixel's form on that live site holds
    SIXTY-SEVEN inputs (id, ev, dl, rl, ts, sw, sh …), none of them declaring a
    type attribute, so .type reports "text" for every one and a type-based
    check waves the whole thing through. What is true of all 67 is that not one
    has ever been painted.

    So the test is layout: the form must occupy space on the page. That also
    survives the common pattern of a checkbox hidden with CSS and styled
    through its label, which a per-control visibility test would reject.
  */
  function isRendered(el) {
    if (!el || !el.getBoundingClientRect) return true;   // cannot tell; don't punish it
    var box = el.getBoundingClientRect();
    return !!(box.width || box.height);
  }

  function isVisitorForm(form) {
    if (!form || form.tagName !== 'FORM') return false;

    // Built by script and never in the page.
    if (form.isConnected === false) return false;

    // Never painted, so nobody filled it in.
    if (!isRendered(form)) return false;

    var els = formElements(form);
    if (!els || typeof els.length !== 'number') return false;

    for (var i = 0; i < els.length; i++) {
      var field = els[i];
      if (!field || COLLECTABLE_TAGS.indexOf(field.tagName) === -1) continue;
      if (field.disabled) continue;
      var type = (field.type || '').toLowerCase();
      // Hidden fields are page-controlled and buttons are not filled in, so
      // neither is evidence that a person was involved.
      if (type === 'hidden' || type === 'submit' || type === 'button' ||
          type === 'reset'  || type === 'image') continue;
      return true;
    }
    return false;
  }

  /*
    The verdict has to be taken before any other handler runs.

    This tag listens at window in the bubble phase, which is deliberate (see
    the hook below) but means the site's own submit handler has already run by
    the time we look. A handler that hides the form on submit — closing a modal,
    swapping in a spinner — would leave us measuring a form that is no longer
    rendered and calling a real lead a pixel. So the judgement is made in the
    capture phase, which runs before every handler on the way down, and the
    bubble phase reads it back.

    One slot is enough: a submit event is dispatched and handled to completion
    before the next one begins.
  */
  var captured = { form: null, visitor: false };

  function visitorVerdict(form) {
    if (captured.form === form) return captured.visitor;
    return isVisitorForm(form);
  }

  // Returns a map of canonical key → normalised value, or null.
  function readUserData(form) {
    var els = formElements(form);
    if (!els || typeof els.length !== 'number') return null;

    var raw = {};
    var found = false;

    for (var i = 0; i < els.length; i++) {
      var field = els[i];
      if (!field || !field.tagName) continue;

      if (SKIP_PASSWORD_FORMS && (field.type || '').toLowerCase() === 'password') {
        log('password field present, skipping form');
        return null;
      }

      if (skipField(field)) continue;

      var key = canonicalKey(field);
      if (!key) continue;

      var value = field.value;
      if (typeof value !== 'string' || !value.trim()) continue;

      if (key === 'full_name') {
        var split = splitFullName(value);
        if (!split) continue;
        if (!raw.first_name) { raw.first_name = split.first_name; found = true; }
        if (!raw.last_name)  { raw.last_name  = split.last_name;  found = true; }
        continue;
      }

      if (raw[key]) continue;                       // first match wins
      var norm = normalise(key, value);
      if (!norm) continue;                          // failed validation, drop it
      raw[key] = norm;
      found = true;
    }

    return found ? raw : null;
  }

  /* ── user_data assembly ─────────────────────────────────────────────
     Google Ads UPD shape. Hashed: email, phone, first/last name, street.
     Plain text: city, region, postal_code, country.                    */

  function buildUserData(raw) {
    var pending = [];
    var hashed = {};

    HASHED_KEYS.forEach(function (key) {
      if (!raw[key]) return;
      pending.push(sha256Hex(raw[key]).then(function (hex) {
        if (hex) hashed[key] = hex;
      }));
    });

    return Promise.all(pending).then(function () {
      var userData = {};
      if (hashed.email)        userData.sha256_email_address = hashed.email;
      if (hashed.phone_number) userData.sha256_phone_number  = hashed.phone_number;

      var address = {};
      if (hashed.first_name) address.sha256_first_name = hashed.first_name;
      if (hashed.last_name)  address.sha256_last_name  = hashed.last_name;
      if (hashed.street)     address.sha256_street     = hashed.street;
      PLAIN_KEYS.forEach(function (key) {
        if (raw[key]) address[key] = raw[key];
      });

      /*
        Country is the field nobody asks for. A UK enquiry form collects a
        name and a postcode and stops, so the set is one value short of
        usable and the value it is short of is the same for every visitor
        the site has.

        Only the country is ever assumed. Guarding this on the rest of the
        set being present would read as extra safety and be dead code — the
        completeness test below already discards an address that is short
        of anything, so stamping a country onto one that is going to be
        dropped changes nothing.
      */
      if (ASSUME_DEFAULT_COUNTRY && !address.country) {
        var assumed = normalise('country', DEFAULT_COUNTRY);
        if (assumed) address.country = assumed;
      }

      /*
        Google's address block is all or nothing: first name, last name,
        postcode and country together, or it discards the whole thing and
        reports "your enhanced conversions addresses are missing required
        fields" in the diagnostics panel.

        So a partial address is not a partial benefit — it is zero benefit
        and a warning. Worse, it is hashed personal data pushed into a
        page-global array for nothing, which is precisely what the rest of
        this file works to avoid. Send the set or send none of it.
      */
      var hasAddress = !!(address.sha256_first_name && address.sha256_last_name &&
                          address.postal_code && address.country);
      if (hasAddress) userData.address = address;
      if (!userData.sha256_email_address && !userData.sha256_phone_number && !hasAddress) {
        log('no matchable identifier, dropping user_data');
        return null;
      }
      return userData;
    });
  }

  /*
    Pushes, and resolves once GTM reports its tags have fired. Every push
    goes through here: a conversion pixel that has not left the browser by
    the time the page unloads is a lost conversion, and that applies just
    as much to the consent-denied event as to the enriched one.
  */
  function pushAndWait(payload) {
    return new Promise(function (resolve) {
      var settled = false;
      var done = function () { if (!settled) { settled = true; resolve(); } };

      window.dataLayer = window.dataLayer || [];
      payload.eventTimeout = MAX_DELAY_MS;
      payload.eventCallback = done;

      setTimeout(done, MAX_DELAY_MS);        // GTM absent or silent
      window.dataLayer.push(payload);
      log('pushed', payload.event, payload);
    });
  }

  /* ── Handlers ───────────────────────────────────────────────────────
     A handler returns a Promise when the submission must be held, or
     null when it has already done its work synchronously.              */

  STATE.handlers.push(function (form) {
    var details = formDetails(form);

    /*
      Every push carries user_data_status, including the successful one.

      Before this existed, four different outcomes — consent denied, no CMP
      signal at all, no matchable field on the form, no SubtleCrypto —
      pushed a byte-identical event, so a broken install and a form with
      nothing to match on were indistinguishable downstream. A live site ran
      that way for months: 342 of 365 conversions arrived with no user data
      and the only trace was a console warning nobody was looking at.
    */
    var push = function (status, cmp, userData) {
      var payload = {
        event: EVENT_NAME,
        form_details: details,
        user_data_status: status
      };
      if (cmp) payload.cmp_detected = cmp;
      if (userData) payload.user_data = userData;
      return pushAndWait(payload);
    };

    // Read before consent is: with no SubtleCrypto nothing can be hashed,
    // so there is no personal data for consent to have an opinion about.
    if (!CAN_HASH) return push('no_crypto', null, null);

    // Consent is read per submission, before any field is touched. GTM
    // gates a tag once, when it decides to run it; the listener installed
    // here outlives that decision, so withdrawal has to be caught at the
    // moment of use.
    var decision = consentDecision();
    if (!decision.collect) return push(decision.status, decision.cmp, null);

    var raw = readUserData(form);
    if (!raw) return push('no_fields', decision.cmp, null);

    /*
      buildUserData can throw synchronously as well as reject, and the two
      need different handling. `.catch` only exists once a promise has been
      returned, so a synchronous throw goes straight past it, out of this
      handler, and into the caller's try/catch at the DOM hook — which logs
      under DEBUG and moves on, pushing no event at all.

      That is not theoretical: a browser extension that replaces
      crypto.subtle with something whose digest() throws, or returns a
      non-promise, produced exactly that. The submission disappeared. It
      breaks the invariant this file states twice, so catch it here where
      the fallback event can still be pushed.
    */
    var building;
    try {
      building = buildUserData(raw);
    } catch (err) {
      log('user data threw synchronously, falling back to the plain event', err);
      return push('error', decision.cmp, null);
    }

    return building.then(function (userData) {
      // buildUserData returns null when nothing survived normalisation, or
      // when what did survive is not enough for Google to match on.
      if (!userData) return push('no_fields', decision.cmp, null);
      return push(decision.status, decision.cmp, userData);
    })['catch'](function (err) {
      log('user data failed, falling back to the plain event', err);
      return push('error', decision.cmp, null);
    });
  });

  /* ── DOM hooks (installed once, shared by both variants) ───────────── */

  if (!STATE.hooked) {
    STATE.hooked = true;
    STATE.nativeSubmit = HTMLFormElement.prototype.submit;

    var collect = function (form) {
      if (!form || form.tagName !== 'FORM') return [];
      if (form.hasAttribute && form.hasAttribute('data-no-track')) return [];
      // Gated here rather than at each hook, so the submit-event path and the
      // programmatic .submit() path cannot drift apart.
      if (!visitorVerdict(form)) {
        log('not a visitor-submitted form, ignoring');
        return [];
      }
      var promises = [];
      for (var i = 0; i < STATE.handlers.length; i++) {
        try {
          var result = STATE.handlers[i](form);
          if (result && typeof result.then === 'function') promises.push(result);
        } catch (err) {
          log('handler threw', err);
        }
      }
      return promises;
    };

    /*
      Bubble phase on window, which runs after every document-level
      listener whatever order they registered in.

      Listening on document was wrong. Handlers on the same node fire in
      registration order, so a delegated $(document).on('submit', ...) —
      the standard WordPress AJAX form pattern, and typically registered
      from the footer, after the GTM container — called preventDefault()
      only after this check had already passed. The form then got natively
      submitted anyway: the site's XHR fired AND the page navigated, so
      the lead posted twice and the visitor landed somewhere the site
      never meant to send them.

      The cost of moving to window is that a document-level handler
      calling stopPropagation() now hides the submission from us
      completely. Losing a conversion beats breaking a client's form.
    */
    /*
      Capture phase, so this runs before any handler the site registered —
      including one that hides the form while it submits. It only records a
      verdict; every decision still happens in the bubble listener below.
    */
    window.addEventListener('submit', function (e) {
      var form = e.target;
      if (!form || form.tagName !== 'FORM') return;
      captured.form = form;
      captured.visitor = isVisitorForm(form);
    }, true);

    window.addEventListener('submit', function (e) {
      if (STATE.resubmitting) return;
      var form = e.target;
      if (!form || form.tagName !== 'FORM') return;

      /*
        The site has already cancelled the native submission, so it is posting
        the form over XHR itself. That is the ordinary shape of a WordPress
        form plugin, and it used to mean the submission was invisible here:
        this listener runs at window, after the document-level handler that
        cancelled it, and an early return on defaultPrevented threw the event
        away.

        Measured on a live site running the HTML Forms plugin, which cancels at
        document and posts to admin-ajax: every real lead went unreported,
        while the Meta Pixel's transport form was counted instead. The two
        faults hid each other — the conversion count looked plausible.

        So report it, and touch nothing else: no preventDefault, no hold, no
        resubmit. Whatever the site decided stands. Values are read
        synchronously inside collect(), before the site's XHR has started, so a
        form that empties itself on success still yields its data.

        This reports the submission being ATTEMPTED. A form posting over XHR
        can still be refused by the server, and nothing available here would
        say so. Where a form plugin publishes its own success event, committing
        on that is the stronger contract — which is what the plugin-specific
        builds in this family do.
      */
      if (e.defaultPrevented) {
        if (!REPORT_AJAX_SUBMISSIONS) return;

        /*
          Double-click guard. An XHR form stays on the page, so an impatient
          visitor can submit it again a moment later; without this that is a
          second conversion for one enquiry.

          The window is fixed rather than tied to when the push resolves. Tying
          it to the push clears in ~10ms once GTM calls back, which is shorter
          than the gap between two human clicks, so it guarded nothing — the
          test caught exactly that.

          A repeat after the window IS reported, deliberately. By then the site
          has genuinely posted twice and the tag should say so rather than
          decide on the site's behalf which submissions were real.
        */
        if (STATE.reported.indexOf(form) !== -1) return;

        if (!collect(form).length) return;

        STATE.reported.push(form);
        setTimeout(function () {
          var seen = STATE.reported.indexOf(form);
          if (seen !== -1) STATE.reported.splice(seen, 1);
        }, MAX_DELAY_MS);
        return;
      }

      // An impatient second click during the hold would otherwise run the
      // whole flow again: two conversions, and the submitter's value
      // appended twice.
      if (STATE.inFlight.indexOf(form) !== -1) {
        e.preventDefault();
        return;
      }

      var promises = collect(form);
      if (!promises.length) return;               // nothing async, let it go

      e.preventDefault();

      // Belt and braces for anything listening on window after us: if it
      // cancels, it still wins.
      var cancelled = false;
      try {
        var nativePreventDefault = e.preventDefault;
        e.preventDefault = function () {
          cancelled = true;
          return nativePreventDefault.apply(e, arguments);
        };
      } catch (err) { /* non-extensible event; the window phase covers it */ }

      STATE.inFlight.push(form);

      var submitter = e.submitter || null;
      var released = false;
      var release = function () {
        if (released) return;
        released = true;

        var queued = STATE.inFlight.indexOf(form);
        if (queued !== -1) STATE.inFlight.splice(queued, 1);

        if (cancelled) {
          log('cancelled by another handler, not resubmitting');
          return;
        }

        var hidden = null;
        var restore = [];
        try {
          if (submitter) {
            // nativeSubmit() has no submitter, so it would otherwise drop
            // both the button's name/value and its form* overrides. A
            // button with formaction="/other" posted to the form's own
            // action instead.
            if (submitter.name) {
              hidden = document.createElement('input');
              hidden.type = 'hidden';
              hidden.name = submitter.name;
              hidden.value = submitter.value || '';
              form.appendChild(hidden);
            }
            ['action', 'method', 'target', 'enctype'].forEach(function (attr) {
              var override = submitter.getAttribute('form' + attr);
              if (override === null) return;
              restore.push([attr, form.getAttribute(attr)]);
              form.setAttribute(attr, override);
            });
          }
          STATE.resubmitting = true;
          STATE.nativeSubmit.call(form);          // does not re-fire submit
        } catch (err) {
          log('resubmit failed', err);
        } finally {
          STATE.resubmitting = false;
          // The form data set is built synchronously by submit(), so this
          // is safe here and stops the injected input accumulating on a
          // form that does not navigate away.
          if (hidden && hidden.parentNode) hidden.parentNode.removeChild(hidden);
          restore.forEach(function (pair) {
            if (pair[1] === null) form.removeAttribute(pair[0]);
            else form.setAttribute(pair[0], pair[1]);
          });
        }
      };

      Promise.all(promises).then(release, release);
      setTimeout(release, MAX_DELAY_MS);          // the form always submits
    }, false);

    // Programmatic form.submit() fires no submit event, so hook it too.
    HTMLFormElement.prototype.submit = function () {
      var form = this;
      var args = arguments;
      var native = function () { return STATE.nativeSubmit.apply(form, args); };

      if (STATE.resubmitting) return native();
      if (STATE.inFlight.indexOf(form) !== -1) return;   // already held

      var promises = collect(form);
      if (!promises.length) return native();

      STATE.inFlight.push(form);

      var released = false;
      var release = function () {
        if (released) return;
        released = true;
        var queued = STATE.inFlight.indexOf(form);
        if (queued !== -1) STATE.inFlight.splice(queued, 1);
        STATE.resubmitting = true;
        try { native(); } catch (err) { log('submit failed', err); }
        finally { STATE.resubmitting = false; }
      };

      Promise.all(promises).then(release, release);
      setTimeout(release, MAX_DELAY_MS);
    };
  }

  log('installed');
})();
</script>
